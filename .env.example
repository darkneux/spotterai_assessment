# Copy to .env and adjust. All values have sane defaults in settings.py,
# so the project runs with zero configuration on SQLite + offline routing.

# --- Core Django ---
DEBUG=True
SECRET_KEY=dev-insecure-change-me
ALLOWED_HOSTS=*

# --- Database ---
# Default is SQLite (no setup). To use PostgreSQL, set DATABASE_URL, e.g.:
# DATABASE_URL=postgres://user:pass@localhost:5432/fuelroute
# DATABASE_URL=sqlite:///db.sqlite3

# --- Vehicle / fuel model ---
FUEL_MAX_RANGE_MILES=500
FUEL_MILES_PER_GALLON=10

# --- Corridor / station selection ---
# Half-width of the corridor around the route used to pick candidate stations.
ROUTE_CORRIDOR_WIDTH_KM=30

# --- Fuel planner ---
# Default strategy: "greedy" or "dp".
FUEL_PLANNER_STRATEGY=greedy

# --- Routing provider: "offline" | "ors" | "osrm" ---
# offline: deterministic great-circle route, no network, no key (default; great for demos/tests).
# ors:     OpenRouteService (free tier, requires ORS_API_KEY).
# osrm:    self-hosted or public OSRM instance (no key).
ROUTING_PROVIDER=offline
ORS_API_KEY=
ORS_BASE_URL=https://api.openrouteservice.org
OSRM_BASE_URL=http://router.project-osrm.org

# --- Geocoding provider for free-text start/end and station addresses ---
# "offline": built-in lookup of well-known US cities + station coords from CSV (no network).
# "census":  US Census Bureau batch/one-line geocoder (no key, US only).
# "nominatim": OpenStreetMap Nominatim (1 req/s public endpoint).
GEOCODING_PROVIDER=offline
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# --- Caching ---
# Default is in-process locmem. To use Redis: REDIS_URL=redis://localhost:6379/0
REDIS_URL=
ROUTING_CACHE_TTL_SECONDS=86400
